# ==========================================
# FlowBoard Root .gitignore (Monorepo)
# ==========================================

# ------------------------------------------
# Environment & Secret Files
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Python (Backend & Websockets)
# ------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Prisma Python / JS artifacts
prisma/client/
generated/prisma/
.prisma/

# ------------------------------------------
# Node.js & Monorepo (Frontend & Packages)
# ------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/
.turbo/
.vercel/

# Build & Bundler Outputs
.next/
out/
build/
dist/
*.tsbuildinfo

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# OS & IDE Specific
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
